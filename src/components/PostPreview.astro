---
import type { Language } from '../lib/site';
import type { WritingPost } from '../lib/posts';

interface Props {
  post: WritingPost;
  locale: Language;
}

const { post, locale } = Astro.props;
const isExternal = post.kind === 'external';
const opensInNewTabLabel =
  locale === 'pl' ? 'otworzy się w nowej karcie' : 'opens in a new tab';
const date = new Intl.DateTimeFormat(locale === 'pl' ? 'pl-PL' : 'en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.date);
---

<li>
  <a
    href={post.href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    {
      isExternal ? `Medium: ${post.title}` : post.title
    }
    {isExternal && <span class="sr-only">({opensInNewTabLabel})</span>}
  </a>
  <span class="text-muted ml-1.5 whitespace-nowrap font-sans text-xs uppercase">
    {date}
  </span>
</li>
